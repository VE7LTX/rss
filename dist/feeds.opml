    <outline text="Electronic Frontier Foundation Updates" title="Electronic Frontier Foundation Updates" type="rss" xmlUrl="https://www.eff.org/rss/updates.xml" htmlUrl="https://www.eff.org/" category="human_rights_civil_liberties" />
    <outline text="FAO News" title="FAO News" type="rss" xmlUrl="https://www.fao.org/feeds/news/en/rss.xml" htmlUrl="https://www.fao.org/" category="agriculture_food_systems" />
    <outline text="IEEE Spectrum" title="IEEE Spectrum" type="rss" xmlUrl="https://spectrum.ieee.org/rss/fulltext" htmlUrl="https://spectrum.ieee.org/" category="engineering_applied_science" />
